<Window x:Class="ToastFish.View.PhoneticChartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="英语音标表"
        WindowStartupLocation="CenterScreen">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="Hint" Grid.Row="0" TextWrapping="Wrap" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="GapColumn" />
                <ColumnDefinition x:Name="ExampleColumn" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ChartHost" />
            </ScrollViewer>

            <StackPanel Grid.Column="2">
                <TextBlock x:Name="ExampleTitle" TextWrapping="Wrap" />
                <Grid x:Name="ExampleHost" />
                <TextBlock x:Name="ReferenceTitle" TextWrapping="Wrap" />
                <StackPanel x:Name="ReferenceHost" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
