<Window x:Class="ToastFish.View.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ToastFish 设置" Width="480" Height="600" MinWidth="480" MinHeight="430"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs" Grid.Row="0">

            <TabItem Header="常规配置">
                <StackPanel Margin="14">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="单词数量" Width="90" VerticalAlignment="Center" />
                        <ComboBox x:Name="NumberBox" Width="120">
                            <ComboBoxItem Content="5" />
                            <ComboBoxItem Content="10" />
                            <ComboBoxItem Content="15" />
                            <ComboBoxItem Content="20" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="主题" Width="90" VerticalAlignment="Center" />
                        <ComboBox x:Name="ThemeBox" Width="120">
                            <ComboBoxItem Content="跟随系统" />
                            <ComboBoxItem Content="浅色" />
                            <ComboBoxItem Content="深色" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="字体" Width="90" VerticalAlignment="Center" />
                        <ComboBox x:Name="FontBox" Width="321" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="基准字号" Width="90" VerticalAlignment="Center" />
                        <TextBox x:Name="FontSizeBox" Width="60" />
                        <TextBlock Text="（12 - 28）" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="Gray" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="播放配置">
                <StackPanel Margin="14">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="发音类型" Width="90" VerticalAlignment="Center" />
                        <ComboBox x:Name="EngTypeBox" Width="120">
                            <ComboBoxItem Content="美国" />
                            <ComboBoxItem Content="英国" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="英文语音" Width="90" VerticalAlignment="Center" />
                        <ComboBox x:Name="VoiceEnBox" Width="321" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="中文语音" Width="90" VerticalAlignment="Center" />
                        <ComboBox x:Name="VoiceCnBox" Width="321" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="语速" Width="90" VerticalAlignment="Center" />
                        <ComboBox x:Name="RateBox" Width="120">
                            <ComboBoxItem Content="很慢" Tag="-8" />
                            <ComboBoxItem Content="慢" Tag="-4" />
                            <ComboBoxItem Content="正常" Tag="0" />
                            <ComboBoxItem Content="快" Tag="4" />
                            <ComboBoxItem Content="很快" Tag="8" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="TestSpeakButton" Content="测试播放例句"
                                Width="110" Height="32" Click="TestSpeak_Click" />
                        <TextBlock x:Name="SpeakTestResult" Margin="10,0,0,0"
                                   VerticalAlignment="Center" Foreground="Gray"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="大模型配置">
                <StackPanel Margin="14">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="接口地址" Width="90" VerticalAlignment="Center" />
                        <TextBox x:Name="AiBaseUrlBox" Width="321" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="API Key" Width="90" VerticalAlignment="Center" />
                        <TextBox x:Name="AiApiKeyBox" Width="321" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="模型" Width="90" VerticalAlignment="Center" />
                        <TextBox x:Name="AiModelBox" Width="321" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="TestAiButton" Content="测试"
                                Width="80" Height="32" Click="TestAi_Click" />
                        <TextBlock x:Name="AiTestResult" Margin="10,0,0,0"
                                   VerticalAlignment="Center" Foreground="Gray"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <TextBlock Text="接口需兼容 OpenAI 的 /chat/completions" FontSize="11"
                               Foreground="Gray" Margin="0,14,0,0" />
                </StackPanel>
            </TabItem>

            <TabItem Header="提示词配置">
                <!-- 两行 Height="*"：提示词很长，两个框对半分满页签高度，窗口拉大也跟着长 -->
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="整句提示词"
                               VerticalAlignment="Top" Margin="0,4,0,0" />
                    <TextBox x:Name="AiPromptSentenceBox" Grid.Row="0" Grid.Column="1"
                             Margin="0,0,0,7"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="单词提示词"
                               VerticalAlignment="Top" Margin="0,11,0,0" />
                    <TextBox x:Name="AiPromptWordBox" Grid.Row="1" Grid.Column="1"
                             Margin="0,7,0,0"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                               Text="翻译窗口没选中文本时用整句提示词，选中了文本时用单词提示词"
                               FontSize="11" Foreground="Gray" Margin="0,14,0,0" />
                </Grid>
            </TabItem>

        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="确定" Width="80" Margin="0,0,8,0" Click="Ok_Click" />
            <Button Content="取消" Width="80" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
