<Window x:Class="ToastFish.View.GojuonChartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="日语五十音图"
        WindowStartupLocation="CenterScreen">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="Hint" Grid.Row="0" TextWrapping="Wrap" />

        <ScrollViewer x:Name="ChartScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="ChartHost" HorizontalAlignment="Left" VerticalAlignment="Top" />
        </ScrollViewer>

        <StackPanel x:Name="ToggleBar" Grid.Row="2" Orientation="Horizontal">
            <CheckBox x:Name="ShowKatakana" />
            <CheckBox x:Name="ShowRomaji" />
        </StackPanel>
    </Grid>
</Window>
