<Window x:Class="ToastFish.View.TranslationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="翻译" WindowStartupLocation="CenterScreen">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <!-- 上半部分初始高度在构造函数里设成右侧三个按钮的总高，可用分隔线拖动 -->
            <RowDefinition x:Name="TopRow" Height="*" MinHeight="60" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="60" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 标签栏放在输入框下方、同一行内部：插成独立行的话，
                 GridSplitter 的 PreviousAndNext 就变成拖标签栏而不是输入框了 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox x:Name="InputBox" Grid.Row="0"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top" />

                <!-- 翻译历史：左右箭头分列两端，中间是折行的标签，箭头高度跟着标签区走 -->
                <Grid x:Name="HistoryBar" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="PrevButton" Grid.Column="0" />
                    <ScrollViewer x:Name="TabsScroll" Grid.Column="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="TabsPanel" />
                    </ScrollViewer>
                    <Border x:Name="NextButton" Grid.Column="2" />
                </Grid>
            </Grid>

            <StackPanel x:Name="ActionPanel" Grid.Column="1">
                <Button x:Name="TranslateButton" Content="翻译" />
                <Button x:Name="PlayButton" Content="播放" />
                <Button x:Name="ConfigButton" Content="配置" />
            </StackPanel>
        </Grid>

        <!-- Border 是那条 1px 的视觉线，GridSplitter 透明叠在上面提供拖动区。
             两者都直接挂在 RootGrid 第 1 行：GridSplitter 的 PreviousAndNext 认的是
             它所在 Grid 里紧邻的上下两行，中间再套一层 Grid 就没有可拖的行了 -->
        <Border x:Name="SplitLine" Grid.Row="1" BorderThickness="0,1,0,0" VerticalAlignment="Center" />
        <GridSplitter x:Name="SplitGrip" Grid.Row="1" HorizontalAlignment="Stretch"
                      VerticalAlignment="Center" Background="Transparent"
                      ResizeBehavior="PreviousAndNext" ResizeDirection="Rows" />

        <!-- 译文区：渲染 Markdown 的只读预览，不带默认工具栏 -->
        <FlowDocumentScrollViewer x:Name="OutputBox" Grid.Row="2"
                                  IsToolBarVisible="False"
                                  VerticalScrollBarVisibility="Auto" />
    </Grid>
</Window>
